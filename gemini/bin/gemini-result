#!/usr/bin/env python3
"""Print only what a caller must know when a run ends: verdict and result.

Reading a run's full task output costs thousands of tokens — the step timeline
is there for the human watching live, not for the agent that launched it. This
prints roughly fifteen lines instead.
"""

import json
import os
import sys
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "gemini-skill"
RUNS = STATE / "runs"


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg:
        run = RUNS / arg
    else:
        current = STATE / "current"
        run = RUNS / current.read_text().strip() if current.exists() else None

    if not run or not run.is_dir():
        print("gemini-result: no such run")
        return 1

    try:
        verdict = json.loads((run / "verdict.json").read_text())
    except Exception:
        verdict = {}

    print(f"gate: {'PASS' if verdict.get('pass') else 'FAIL'}")
    for reason in verdict.get("reasons", []):
        print(f"  - {reason}")
    for item in verdict.get("verify", []):
        print(f"  [{'ok' if item.get('exit') == 0 else 'FAIL'}] {item.get('command')}")
    touched = verdict.get("touched") or []
    if touched:
        print(f"touched ({len(touched)}): " + ", ".join(touched[:12]))

    try:
        result = json.loads((run / "result.json").read_text())
    except Exception:
        result = {}
    for key in ("status", "risk", "summary", "next"):
        if result.get(key):
            print(f"{key}: {result[key]}")
    for finding in result.get("findings", []):
        print(f"finding: {finding}")

    attempts = len(list(run.glob("events-*.ndjson")))
    print(f"attempts: {attempts}  tokens: {result.get('gemini_tokens', 0)}  run: {run.name}")
    return 0 if verdict.get("pass") else 1


if __name__ == "__main__":
    sys.exit(main())
