#!/usr/bin/env python3
import os
from pathlib import Path

ROOT = Path(os.environ.get("XDG_STATE_HOME", Path.home()/".local/state")) / "gemini-skill/runs"
if not ROOT.exists():
    print("No Gemini runs.")
    raise SystemExit

for p in sorted((x for x in ROOT.iterdir() if x.is_dir()), key=lambda x:x.stat().st_mtime, reverse=True)[:20]:
    r = p/"result.json"
    state = "running"
    if r.exists():
        try:
            import json
            state = json.loads(r.read_text()).get("status","completed")
        except Exception:
            state = "completed"
    print(f"{p.name:32} {state:16} {p}")
